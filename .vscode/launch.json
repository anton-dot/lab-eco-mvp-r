{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "restart": true,
            "cwd": "${workspaceFolder}/backend",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "preLaunchTask": "Start Backend"
        },
        {
            "name": "Frontend",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:2468",
            "webRoot": "${workspaceFolder}/src",
            "preLaunchTask": "Start Frontend"
        }
    ],
    "compounds": [
        {
            "name": "Full",
            "configurations": [
                "Backend",
                "Frontend"
            ]
        }
    ]
}